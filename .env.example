# Django
DJANGO_SECRET_KEY=replace-with-a-local-development-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# MongoDB — use the connection strategy selected by the team
MONGODB_URI=
MONGODB_DATABASE=ai_meeting_intelligence

# Groq
GROQ_API_KEY=

# Frontend API URL
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Background jobs
REDIS_URL=redis://localhost:6379/0

# Private file storage — configure only the provider selected by the team
STORAGE_PROVIDER=local

# Demo logins 
VITE_ADMIN_EMAIL=admin@meetingintel.com
VITE_ADMIN_PASSWORD=123456
VITE_MANAGER_EMAIL=manager@meetingintel.com
VITE_MANAGER_PASSWORD=manager123
